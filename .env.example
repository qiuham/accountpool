MAIL_BASE=https://mail.example.com
# 新建邮箱地址 = 邮箱前缀 + 持久化递增序号 + @邮箱域名；前端配置序号宽度
# 前缀允许英文字母、数字、-、_，最多 48 字符
MAIL_PREFIX=claude
MAIL_DOMAIN=example.com
# 邮箱服务管理员密码/鉴权值，不是 Claude 密码；通过 x-admin-auth 发送
MAIL_ADMIN_AUTH=
# 以下仅用于 CRS 导出，不是管理台登录。
ACCOUNTPOOL_API_USER=
ACCOUNTPOOL_API_PASSWORD=

# 免费池目标、每日上限、健康检查周期与邮箱配置在管理台保存。
# 以下仅控制宿主机监听端口。
ACCOUNTPOOL_PORT=8787
# 可选首次初始化密钥；留空由 API 启动时随机生成并打印。
ACCOUNTPOOL_SETUP_KEY=

# Docker 服务统一使用原数据库的时区。现有账号池使用 Asia/Shanghai。
TZ=Asia/Shanghai
ACCOUNTPOOL_WORKER_MEMORY=3g
ACCOUNTPOOL_WORKER_CPUS=1.5
