# 每账号字体子集引擎副本（硬链接树，按需生成）
.subsets/

# 账号运行态：profile、指纹、cookie 都在这里，绝不入库
bundles/
artifacts/

# Python
.venv*/
__pycache__/
*.pyc

# Node
node_modules/

# 运行配置（含邮箱服务凭据）
config.toml

# Private local configuration and backup material
.env
config.toml
backups/

# Generated executables, SQLite and execution journals
bin/
*.db
*.db-shm
*.db-wal
*.db.worker.lock
.active-execution.json

# One-command deployment state
data/
.deployment/
